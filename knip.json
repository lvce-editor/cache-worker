{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/cache-worker": {
      "entry": ["src/index.js", "src/cacheWorkerMain.js"],
      "project": ["src/**/*.js", "test/**/*.js"]
    },
    "packages/build": {
      "entry": ["src/build.js", "src/computeNodeModulesCacheKey.js"],
      "project": ["src/**/*.js"]
    },
    "packages/e2e": {
      "entry": ["e2e.config.js", "src/**/*.js"],
      "project": ["*.js", "src/**/*.js"]
    },
    "packages/server": {
      "entry": ["src/server.js"],
      "project": ["src/**/*.js"]
    }
  }
}
