{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "webworker"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "composite": true
  },
  "include": ["src", "test"]
}
